{
  "name": "figma-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "convex dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --packages=external --outfile=mcp/dist/server.mjs",
    "mcp": "node mcp/dist/server.mjs",
    "dev:backend:local": "cross-env CONVEX_AGENT_MODE=anonymous convex dev",
    "deploy:backend": "convex deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "convex": "^1.49.0",
    "lucide-react": "^1.71.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
